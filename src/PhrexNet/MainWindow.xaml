<Window x:Class="PhrexNet.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PhrexNet | CodePhrex" Width="1200" Height="800" MinWidth="800" MinHeight="500" Background="#0B1018" Foreground="White">
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DockPanel Background="#172333">
<StackPanel DockPanel.Dock="Top" Margin="20"><TextBlock Text="PhrexNet" FontSize="30" Foreground="#00C8F0" FontWeight="Bold"/><TextBlock Text="BY CODEPHREX" Foreground="#A5B4C7"/></StackPanel>
<TextBlock DockPanel.Dock="Bottom" Text="v0.1.0 • Foundation preview" Margin="16" Foreground="#A5B4C7"/>
<ListBox x:Name="Navigation" Background="Transparent" Foreground="White" BorderThickness="0" Margin="12" SelectionChanged="Navigate">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,9"/><Setter Property="Foreground" Value="White"/></Style></ListBox.ItemContainerStyle>
</ListBox>
</DockPanel>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="32">
<TextBlock x:Name="PageTitle" FontSize="32" FontWeight="SemiBold"/>
<TextBlock Text="Discover. Understand. Secure. Control." Foreground="#A5B4C7" Margin="0,8,0,24"/>
<Border Background="#172333" CornerRadius="8" Padding="20"><StackPanel><TextBlock x:Name="PageDescription" TextWrapping="Wrap" FontSize="16"/><TextBlock Text="No network probes are sent by this preview." Foreground="#00C8F0" Margin="0,16,0,0"/></StackPanel></Border>
<StackPanel x:Name="AdapterPanel" Visibility="Collapsed" Margin="0,24,0,0"><Button Content="Refresh local adapters" Click="RefreshAdapters" HorizontalAlignment="Left" Padding="12,6"/><TextBlock x:Name="AdapterResults" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
<StackPanel x:Name="ScopePanel" Visibility="Collapsed" Margin="0,24,0,0">
<TextBlock Text="Offline scope preview" FontSize="20"/>
<TextBlock Text="Canonical IPv4 CIDR (/24–/32)" Margin="0,8,0,4"/>
<TextBox x:Name="ScopeCidr" MaxLength="32"/>
<TextBlock Text="Excluded IPv4 addresses (comma separated)" Margin="0,8,0,4"/>
<TextBox x:Name="ScopeExclusions" MaxLength="4096"/>
<CheckBox x:Name="ScopeConfirmed" Foreground="White" Content="I confirm this scope is authorized" Margin="0,12,0,8"/>
<Button Content="Preview targets (no traffic)" Click="PreviewScope" HorizontalAlignment="Left" Padding="12,6"/>
<TextBlock x:Name="ScopeResults" TextWrapping="Wrap" Margin="0,12,0,0"/>
</StackPanel>
<TextBlock Text="WORKSPACE STATUS" Foreground="#A5B4C7" Margin="0,32,0,12"/>
<UniformGrid Columns="3"><Border Background="#172333" Margin="0,0,8,0" Padding="16" CornerRadius="8"><StackPanel><TextBlock Text="Assets"/><TextBlock Text="Not collected" FontSize="18" Margin="0,8,0,0"/></StackPanel></Border><Border Background="#172333" Margin="4,0" Padding="16" CornerRadius="8"><StackPanel><TextBlock Text="Scope"/><TextBlock Text="Not configured" FontSize="18" Margin="0,8,0,0"/></StackPanel></Border><Border Background="#172333" Margin="8,0,0,0" Padding="16" CornerRadius="8"><StackPanel><TextBlock Text="Scan engine"/><TextBlock Text="Not available" FontSize="18" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
</StackPanel></ScrollViewer>
</Grid></Window>